<%- include('../partials/header') %>

<div class="container">
  <div class="page-header">
    <h2>💊 Dorilar ro'yxati</h2>
    <a href="/medicines/add" class="btn btn-success">+ Yangi dori qo'shish</a>
  </div>
  
  <div class="medicines-grid">
    <% medicines.forEach(medicine => { %>
      <div class="medicine-card">
        <div class="medicine-header">
          <h3><%= medicine.name %></h3>
          <span class="price"><%= medicine.price.toLocaleString() %> so'm</span>
        </div>
        
        <div class="medicine-body">
          <p><strong>Ishlab chiqaruvchi:</strong> <%= medicine.manufacturer %></p>
          <p><strong>Miqdori:</strong> <span class="quantity"><%= medicine.quantity %> dona</span></p>
          <p><strong>Yaroqlilik:</strong> <%= new Date(medicine.expiryDate).toLocaleDateString('uz-UZ') %></p>
          <p class="description"><%= medicine.description %></p>
        </div>
        
        <div class="medicine-actions">
          <a href="/medicines/edit/<%= medicine.id %>" class="btn btn-warning btn-sm">✏️ Tahrirlash</a>
          <form action="/medicines/delete/<%= medicine.id %>" method="POST" style="display: inline;">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Rostdan ham o\'chirmoqchimisiz?')">
              🗑️ O'chirish
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
  
  <% if (medicines.length === 0) { %>
    <div class="empty-state">
      <p>Hozircha dorilar ro'yxati bo'sh</p>
      <a href="/medicines/add" class="btn btn-primary">Birinchi dorini qo'shing</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>